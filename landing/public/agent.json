{
  "name": "Monad Mate",
  "description": "Stake-to-interact social dApp on Monad. Stake MON to DM, match, and meet. No-shows get slashed.",
  "url": "http://localhost:9999",
  "api": "http://localhost:9999/api",
  "docs": "http://localhost:9999/api/docs",
  "openapi": "http://localhost:9999/openapi.json",
  "agent_guide": "http://localhost:9999/agent.md",
  "agents_guide": "http://localhost:9999/agents.md",
  "mcp_server": "http://localhost:9999/mcp-server-card.json",
  "capabilities": [
    "wallet-auth",
    "staking",
    "matching",
    "messaging",
    "attestation",
    "nft-minting",
    "mon-transfers",
    "reputation",
    "ai-matchmaking",
    "x402-payments"
  ],
  "auth": {
    "type": "jwt",
    "flow": "wallet-signature-challenge",
    "header": "Authorization",
    "scheme": "Bearer"
  },
  "network": "monad-testnet",
  "payment_network": "base-mainnet",
  "sdks": "http://localhost:9999/sdks.txt",
